# ---- Core ----
PORT=8080
# Leave DATABASE_URL empty to use embedded Postgres (PGlite) in DATA_DIR. DATA_DIR=memory = no persistence.
DATABASE_URL=
DATA_DIR=.data
# Engine cycle interval for the background timer (long-running mode only)
TICK_MS=5000
# Set when the console is hosted separately, e.g. https://ordo.vercel.app
CORS_ORIGINS=
# Background timer that pulls data and advances runs: auto (on locally, off on Vercel) | on | off
ENGINE_TIMER=auto
# Every stage runs on a machine: required (a run starts only when each stage has one) | optional (a stage with none waits for a person)
STAGE_MACHINES=required
# Machine bodies (virtual machines with their own agent): local (a process per machine) | sandbox (Vercel Sandbox) | off
BODY_RUNTIME=off
# Vercel Sandbox, for BODY_RUNTIME=sandbox
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_SANDBOX_PROJECT=
# How a body reaches Ordo (default: loopback on PORT for local, the public URL for sandbox), where the local
# runtime finds the built body (default body/dist/body.mjs), and how long its process takes over one stage (s)
BODY_ORDO_URL=
BODY_BUNDLE=
BODY_STAGE_S=30
BODY_DECIDE_S=10
BODY_BUY_S=10

# ---- Accounts (wallet sign-in) ----
# Only this wallet may create sites. Empty: any signed-in wallet can create its own site.
BOOTSTRAP_ADMIN_ADDRESS=
SESSION_TTL_HOURS=72
# Optional RPC so smart-contract wallets (ERC-1271 / ERC-6492) can sign in and sign decisions
AUTH_RPC_URL=
# Chain id put in EIP-712 signatures when the wallet does not report one (296 = Hedera testnet)
SIGNATURE_CHAIN_ID=296

# ---- On-chain trust: OrdoTrust (deploy with: pnpm --filter @ordo/contracts deploy:trust) ----
# All of these together turn on role credentials and validator and tester stakes on-chain; leave empty to keep roles in Ordo only.
TRUST_RPC_URL=
TRUST_CHAIN_ID=
TRUST_CHAIN_NAME=Hedera Testnet
TRUST_EXPLORER_URL=
TRUST_CONTRACT_ADDRESS=
# Pays gas to relay signed grants, releases, selections, cases and claims. It has no authority of its own.
TRUST_RELAYER_KEY=
TRUST_SYMBOL=HBAR
# 8 on Hedera (tinybars inside the EVM), 18 on other chains
TRUST_DECIMALS=8
# OrdoWorkOrders (the maintenance agent escrows vendor payments) and OrdoPolicies (a manager publishes each line's
# autonomy policy), both bound to OrdoTrust. Created by the "Hedera setup" workflow (contracts).
TRUST_WORKORDERS_ADDRESS=
TRUST_POLICIES_ADDRESS=

# ---- AI agents: offline | claude | gemini | openai_compat | 0g ----
# Unset: Claude when ANTHROPIC_API_KEY is set, else offline
# LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Or Workload Identity Federation instead of a key (docs/claude-wif.md); on Vercel the identity token comes from the platform
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_…
# ANTHROPIC_ORGANIZATION_ID=…
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_…
# ANTHROPIC_WORKSPACE_ID=wrkspc_…
# ANTHROPIC_IDENTITY_TOKEN_FILE=/var/run/secrets/anthropic.com/token
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---- Ledger anchoring: local | hedera ----
ANCHOR=local
# Ed25519 PKCS8 DER, base64. Generate with:
# node -e "const{generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
LEDGER_SIGNING_KEY=
# Anchor the ledger head after this many new entries (and at least every 30 minutes)
ANCHOR_EVERY=50

# ---- Partner rails (see contracts/README.md) ----
# IDENTITY: plain | ens (shows people's primary ENS names)
IDENTITY=plain

# Hedera: the operator submits ledger anchors to HEDERA_TOPIC_ID (with ANCHOR=hedera) and agent audit entries.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_BUILD_TOPIC_ID=
# The maintenance agent's own account. It escrows work order payments in OrdoWorkOrders; with HEDERA_AGENT_ID on a
# Hedera chain it does so through Hedera Agent Kit. Created by the "Hedera setup" workflow (agent).
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
# Lot passports: the HTS NFT collection ("Hedera setup" workflow, passport). The operator mints one NFT per lot.
HEDERA_PASSPORT_TOKEN_ID=
# Deadlines on Hedera's Schedule Service (on whenever the operator is set): escrow refunds and validator payouts
# need OrdoTrust/OrdoWorkOrders on Hedera; stage timeouts need HEDERA_TOPIC_ID. "off" leaves them to the server.
HEDERA_SCHEDULES=on
# x402: Ordo sells vibration assessments at POST /v1/x402/vibration-assessment, paid in HBAR through an x402
# facilitator (fees to X402_PAY_TO, default the operator). With HEDERA_AGENT_ID, the agent buys one per work order
# from X402_ASSESSMENT_URL (default this deployment's PUBLIC_URL), paying at most X402_MAX_TINYBARS a call.
X402_PAY_TO=
X402_PRICE_TINYBARS=10000000
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_ASSESSMENT_URL=
X402_MAX_TINYBARS=50000000
# Pay on proof (from Hedera setup: stablecoin, payonproof): Ordo USD made with Stablecoin Studio, and OrdoPayOnProof,
# on the OrdoTrust chain (TRUST_RPC_URL, TRUST_CHAIN_ID, TRUST_RELAYER_KEY holds the stablecoin's cash-in role)
# STABLECOIN_ADDRESS=0x…
# STABLECOIN_TOKEN_ADDRESS=0x…
STABLECOIN_SYMBOL=OUSD
STABLECOIN_DECIMALS=6
# PAY_ON_PROOF_ADDRESS=0x…
PAY_ON_PROOF_PARTY_TINYBARS=500000000
# Public base URL for passport links, QR codes and proof-of-work commands. Empty: RENDER_EXTERNAL_URL on Render, a Vercel
# preview's own URL on a preview, the production domain on Vercel production, else the request's origin.
PUBLIC_URL=

# Ethereum mainnet RPC for ENS reverse resolution (a public default is used when empty)
ENS_RPC_URL=
# ENSv2 names on Sepolia, from the ENS setup workflow: the parent name, its UserRegistry, Ordo's resolver, and the
# key that administers them. The site, its people, assets and agents get names under the parent.
ENS_PARENT_NAME=
ENS_REGISTRY_ADDRESS=
ENS_RESOLVER_ADDRESS=
ENS_OWNER_KEY=
ENS_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# OrdoEnsRoles and OrdoLotResolver (ENS setup workflow, `contracts <url>`): contracts read roles from member names,
# and every lot gets a lot-<order>.<site>.<parent> name answered by this app's CCIP-Read gateway. Set both or neither.
ENS_ROLES_ADDRESS=
ENS_LOT_RESOLVER_ADDRESS=

# 0G Galileo testnet (chain 16602). EVIDENCE_STORE=0g copies evidence to 0G Storage, encrypted; LLM_PROVIDER=0g runs
# diagnosis on 0G Compute (needs a funded compute ledger) and checks each answer's TEE signature.
EVIDENCE_STORE=local
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_PRIVATE_KEY=
ZG_PROVIDER_ADDRESS=
# OrdoAgentNFT on 0G Galileo (from the 0G setup workflow): each agent of each site is an ERC-7857 iNFT
ZG_INFT_ADDRESS=

# 0G Private Computer: the Router that runs the proof-of-work interview in TEEs. Mainnet by default (where the
# account's credits are); 0G Storage and the agent NFTs above stay on Galileo testnet.
ZG_ROUTER_NETWORK=mainnet
# Management key (mk-…) from pc.0g.ai, made by the wallet that holds the credits (Key Manager: account:read,
# keys:read, keys:create, keys:manage). Unset: sessions use the CLI's scripted interviewer, no TEE.
# ZG_ROUTER_MGMT_KEY=mk-…
# private (TEE providers only) by default. standard routes to any provider, with no TEE, and Ordo, the CLI and the machines
# label every answer so: use it, with an omni model such as qwen3-omni-flash (images and audio), while no private provider
# serves your model (the doctor's "0g private computer" rail tells you).
ZG_ROUTER_TRUST_MODE=private
# The chat model, served by TeeML providers in private mode (a model only TeeTLS providers serve fails here)
ZG_ROUTER_MODEL=0gm-1.0-35b-a3b
# Speech to text for voice notes, also TeeML. Unset: whisper-large-v3 on mainnet, none on testnet. Empty: none.
# ZG_ROUTER_AUDIO_MODEL=whisper-large-v3
# Most one session's key may spend, in the account's units (0G wei or micro-USD), digits only. Unset: no cap.
# ZG_ROUTER_CREDIT_LIMIT=

# ---- Proof of work ----
# The npm package contributors run: npx <package>@latest <token>
POW_PACKAGE=ordo-pow
# How long a session (and its Router key) stays open, 10 to 1440 minutes
POW_SESSION_MINUTES=120

# ---- Org treasury (OrdoTreasury, docs/hedera.md) ----
# Run budgets and machines' over-budget top-ups as Hedera scheduled transfers from each org's treasury, which a manager
# approves (HIP-755). Needs the OrdoTrust settings on Hedera, the operator, and HEDERA_TOPIC_ID for top-up reasoning.
# Unset: machines spend only what their wallets hold. Deploy with `pnpm setup:hedera treasury` (contracts/).
# TREASURY_CONTRACT_ADDRESS=0x…
# Margin on a run's resource costs (percent), and how long a budget or top-up waits for approval (hours, at most 1488)
TREASURY_BUDGET_MARGIN_PCT=10
TREASURY_BUDGET_HOURS=24
# What the operator puts in an org's new treasury, and the largest top-up a machine may ask for (tinybars)
TREASURY_SEED_TINYBARS=0
TREASURY_TOPUP_MAX_TINYBARS=10000000000
