{
  "name": "@ordo/body",
  "private": true,
  "type": "module",
  "description": "A virtual machine's body: simulates its process, captures and signs the media of its stages' outcomes, reads them through 0G and stops safely without it.",
  "bin": {
    "ordo-body": "dist/body.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/body.mjs",
    "replay": "node dist/body.mjs replay"
  },
  "dependencies": {
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
